{
  "name": "@sentinelauth/sdk",
  "version": "0.1.0",
  "description": "Official SDK for SentinelAuth — adaptive, AI-powered authentication",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "pnpm --filter @sentinelauth/types build && tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "authentication",
    "auth",
    "mfa",
    "security"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@sentinelauth/types": "workspace:*"
  }
}
