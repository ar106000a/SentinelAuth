// dashboard/tsconfig.json
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Next.js owns module resolution/output — these override the Node-oriented
    // NodeNext settings in the base, which don't apply to a bundled browser app.
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Needed for a browser/React app; the base has neither since it's written
    // for Node services.
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "preserve",

    // Standard Next.js requirements.
    "allowJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }

    // target, strict, skipLibCheck, forceConsistentCasingInFileNames,
    // declaration/declarationMap/sourceMap all inherited from the base —
    // declaration/sourceMap are effectively moot here since noEmit suppresses
    // all output anyway.
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "globals.d.ts"
  ],
  "exclude": ["node_modules"]
}
